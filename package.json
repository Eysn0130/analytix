{
  "name": "analytix",
  "productName": "Analytix",
  "version": "1.0.6",
  "description": "Electron workbench for the analytix runtime (HTTP/SSE)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:data-native:development && npm run build:runtime && electron-vite dev",
    "dev:fast": "electron-vite dev",
    "dev:test-account": "node ./scripts/dev-test-account-launcher.mjs --dev",
    "e2e:test-account": "node ./scripts/dev-test-account-launcher.mjs --built",
    "build": "npm run build:runtime && electron-vite build",
    "build:runtime": "node ./scripts/ensure-runtime-install.cjs && npm --prefix packages/runtime run build",
    "build:data-native": "node ./scripts/build-data-analysis-native-tools.cjs",
    "build:data-native:development": "node ./scripts/build-data-analysis-native-tools.cjs --development",
    "build:data-native:package": "node ./scripts/build-data-analysis-native-tools.cjs --all-package-targets",
    "build:data-native:cached": "node ./scripts/build-windows-release-cache.cjs data-native",
    "build:backend-win-runtime": "node ./scripts/build-windows-backend-runtime-assets.cjs",
    "build:backend-win-runtime:cached": "node ./scripts/build-windows-release-cache.cjs backend-win-runtime",
    "verify:data-engine-owner:win": "node ./scripts/verify-data-engine-single-owner.cjs",
    "verify:windows-qa-runbook": "node ./scripts/verify-windows-qa-runbook.mjs",
    "verify:windows-qa-runbook:history": "node ./scripts/verify-windows-qa-runbook.mjs --require-history-clean",
    "verify:windows-qa-runbook:indexed": "node ./scripts/verify-windows-qa-runbook.mjs --require-indexed",
    "verify:repository-history-hygiene": "node ./scripts/verify-repository-history-hygiene.mjs",
    "verify:openspec-codex-skills": "node ./scripts/verify-openspec-codex-skills.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "git:setup": "node ./scripts/setup-git-sync.mjs",
    "test:git-sync": "node --test ./scripts/git-sync.test.mjs",
    "funds:p0:contracts": "node ./plugins/analytix-fund-analysis/scripts/p0-contract-suite.mjs",
    "dist": "npm run build:data-native:package && npm run build && npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never",
    "dist:mac": "rm -f dist/analytix-*-mac-* dist/latest-mac.yml && npm run build && npm run dist:mac:x64:dmg && npm run dist:mac:x64:zip && npm run dist:mac:arm64:dmg && npm run dist:mac:arm64:zip && node ./scripts/generate-mac-latest.cjs dist",
    "dist:mac:signed": "rm -f dist/analytix-*-mac-* dist/latest-mac.yml && MAC_SIGN=1 npm run dist:mac:x64 && MAC_SIGN=1 npm run build && MAC_SIGN=1 npm run dist:mac:arm64:dmg && MAC_SIGN=1 npm run dist:mac:arm64:zip && node ./scripts/generate-mac-latest.cjs dist",
    "dist:mac:arm64": "npm run build:data-native:development -- --platform darwin --arch arm64 && npm run build && npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never --mac dmg --arm64",
    "dist:mac:x64": "npm run build && npm run dist:mac:x64:dmg && npm run dist:mac:x64:zip",
    "dist:mac:arm64:dmg": "node ./scripts/build-data-analysis-native-tools.cjs --platform darwin --arch arm64 && npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never --mac dmg --arm64",
    "dist:mac:x64:dmg": "node ./scripts/build-data-analysis-native-tools.cjs --platform darwin --arch x64 && npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never --mac dmg --x64",
    "dist:mac:arm64:zip": "node ./scripts/zip-mac-app.cjs arm64",
    "dist:mac:x64:zip": "node ./scripts/zip-mac-app.cjs x64",
    "dist:win": "npm run dist:win:official",
    "dist:win:standard": "npm run dist:win:official",
    "dist:win:official": "node ./scripts/require-official-windows-host.cjs && node ./scripts/clean-standard-win-dist.cjs && node ./scripts/stage-private-pwsh.cjs && npm run build:backend-win-runtime:cached && npm run build:data-native:cached && npm run build && npx --yes electron-builder@26.15.3 --config electron-builder.standard-win.cjs --publish never --win nsis --x64 && node ./scripts/postpackage-standard-win-bootstrapper.cjs && node ./scripts/audit-windows-package.cjs",
    "dist:linux": "node ./scripts/build-data-analysis-native-tools.cjs --platform linux --arch x64 && npm run build && npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never --linux AppImage --x64",
    "release:all": "bash ./scripts/release-mac.sh",
    "release:mac": "bash ./scripts/release-mac.sh",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-win.ps1",
    "release:win:official": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-win.ps1",
    "r2:upload": "node ./scripts/publish-r2.mjs upload",
    "r2:promote": "node ./scripts/publish-r2.mjs promote",
    "postinstall": "node ./scripts/postinstall.cjs",
    "verify:apple": "node ./scripts/verify-apple-signing.cjs",
    "preview": "electron-vite preview",
    "scan:product-sovereignty": "node ./scripts/scan-product-sovereignty.cjs",
    "audit:artifact-legal-obligations": "node ./scripts/artifact-legal-obligations-audit.mjs --json",
    "audit:upstreams": "node ./scripts/upstream-source-audit.mjs --json",
    "cache:first-review": "node ./scripts/cache-first-review-gate.mjs",
    "qa:runtime:packaged": "node ./scripts/runtime-go-validation-command.mjs packaged-qa",
    "runtime:go:preflight": "node ./scripts/runtime-go-validation-command.mjs preflight",
    "runtime:go:rc-control-plane": "node ./scripts/runtime-go-validation-command.mjs rc-control-plane",
    "runtime:go:release-gate": "node ./scripts/runtime-go-validation-command.mjs release-gate",
    "runtime:go:live-evidence": "node ./scripts/runtime-go-validation-command.mjs live-evidence",
    "runtime:go:live-validation": "node ./scripts/runtime-go-validation-command.mjs live-validation",
    "runtime:go:local-validation": "node ./scripts/runtime-go-validation-command.mjs local-validation",
    "runtime:go:health-smoke": "node ./scripts/runtime-go-validation-command.mjs runtime-health-smoke",
    "runtime:go:performance-check": "node ./scripts/runtime-go-validation-command.mjs performance-check",
    "runtime:go:speed-cache-gate": "node ./scripts/runtime-go-validation-command.mjs speed-cache-gate",
    "bench:streaming-ui": "node ./scripts/streaming-ui-benchmark.mjs --gate",
    "runtime:go:product-regression": "node ./scripts/runtime-go-validation-command.mjs product-regression",
    "runtime:go:approval-user-input-evidence": "node ./scripts/runtime-go-validation-command.mjs approval-user-input-evidence",
    "runtime:go:packaged-soak": "node ./scripts/runtime-go-validation-command.mjs packaged-soak",
    "runtime:go:packaged-gui-smoke": "node ./scripts/runtime-go-validation-command.mjs packaged-gui-smoke",
    "runtime:go:packaged-milestone-a": "node ./scripts/runtime-go-validation-command.mjs packaged-milestone-a",
    "runtime:go:packaged-milestone-b": "node ./scripts/runtime-go-validation-command.mjs packaged-milestone-b",
    "runtime:go:default-readiness-report": "node ./scripts/runtime-go-validation-command.mjs default-readiness-report",
    "runtime:go:rollback-retirement-evidence": "node ./scripts/runtime-go-validation-command.mjs rollback-retirement-evidence",
    "runtime:go:rollback-retirement-report": "node ./scripts/runtime-go-validation-command.mjs rollback-retirement-report",
    "runtime:go:ts-retirement-scan": "node ./scripts/runtime-go-validation-command.mjs ts-retirement-scan",
    "runtime:go:reasonix-live-parity": "node ./scripts/runtime-go-validation-command.mjs reasonix-live-parity",
    "runtime:go:cutover-report": "node ./scripts/runtime-go-validation-command.mjs cutover-report",
    "runtime:go:engine-absorption-report": "node ./scripts/runtime-go-validation-command.mjs engine-absorption-report",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "mac:unquarantine": "bash ./scripts/mac-unquarantine.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@computer-use/nut-js": "^4.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@peculiar/x509": "2.0.0",
    "@tencent-weixin/openclaw-weixin": "2.4.3",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-list": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/markdown": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "analytix-computer-use": "file:vendor/analytix-computer-use",
    "better-sqlite3": "^12.10.0",
    "docx": "9.7.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "i18next": "^25.4.2",
    "jimp": "^1.6.1",
    "jszip": "3.10.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.544.0",
    "node-pty": "^1.1.0",
    "openclaw": "file:vendor/openclaw-shim",
    "pdfjs-dist": "^5.4.394",
    "proxy-agent": "^6.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "0.2.2",
    "rehype-harden": "^1.1.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "unified": "11.0.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "^1.3.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "^5.2.0",
    "acorn": "^8.16.0",
    "autoprefixer": "^10.4.21",
    "electron": "41.10.3",
    "electron-vite": "^3.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "29.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.7"
  },
