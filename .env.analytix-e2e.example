# Copy this file to .env.analytix-e2e.local.
# The local file is git-ignored and is read by:
#   npm run dev:test-account
#   npm run e2e:test-account

ANALYTIX_HUB_TEST_EMAIL=your-test-account@example.com
ANALYTIX_HUB_TEST_PASSWORD=replace-with-local-secret

# Optional: bypass email/password login when a pre-issued desktop auth token and
# gateway token are available. This keeps the model path on the analytix-hub
# account-token gateway instead of an external provider API key.
# ANALYTIX_HUB_TEST_DESKTOP_AUTH_TOKEN=
# ANALYTIX_HUB_TEST_GATEWAY_TOKEN=
# ANALYTIX_HUB_TEST_GATEWAY_BASE_URL=https://analytix.top/v1

# Optional: pin an already built Go runtime-server binary. The launcher will use
# the newest .cache/runtime-go/**/runtime-server when this is omitted.
# ANALYTIX_GO_RUNTIME_SERVER_BIN=/absolute/path/to/runtime-server

# Optional: pin the Electron userData directory. By default each run uses a
# temporary directory so normal desktop sessions are not polluted.
# ANALYTIX_USER_DATA_DIR=/tmp/analytix-e2e-profile
