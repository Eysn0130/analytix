{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/contracts/**/*.ts",
    "src/config/**/*.ts",
    "src/cli/**/*.ts",
    "src/telemetry/**/*.ts",
    "src/hooks/hook-config.ts",
    "src/hooks/hook-phases.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/conformance",
    "src/conformance/**/*",
    "tests",
    "**/*.test.ts",
    "vitest.config.ts"
  ]
}
