# Copy to scripts/release.local.env.
# This file is intentionally safe to commit; release.local.env is ignored.

### Cloudflare R2 / S3 upload
S3_BUCKET=analytix
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Public download domain used in latest.json and electron-updater metadata.
# Use an R2 custom domain for production, not the authenticated S3 endpoint.
R2_PUBLIC_BASE_URL=https://www.analytix-agent.com/api/r2
ANALYTIX_RELEASE_PREFIX=analytix

# Optional override for electron-updater metadata generated by dist:win:official.
# Defaults to the standard stable feed when unset.
ANALYTIX_STANDARD_WIN_UPDATE_FEED_URL=https://www.analytix-agent.com/api/r2/analytix/channels/stable/latest/

# Default release channel for scripts when --channel is not passed.
# The project default is stable; pass --beta or --channel beta for beta releases.
RELEASE_CHANNEL=stable

### Windows official release cache
# Keep this outside throwaway workspaces so Python/Rust prerequisite outputs and
# Cargo target artifacts survive iterative release builds.
ANALYTIX_WINDOWS_RELEASE_CACHE=C:\Users\analytix_remote\Projects\analytix-cache\windows-release

# Optional archive root for completed Windows installers.
# Defaults to <current-user-desktop>\Analytix-Releases\win when unset.
ANALYTIX_WINDOWS_RELEASE_ARCHIVE_ROOT=C:\Users\analytix_remote\Desktop\Analytix-Releases\win

### Windows Authenticode authority
WIN_CSC_LINK=C:\path\to\analytix-signing.pfx
WIN_CSC_KEY_PASSWORD=<pfx-password>
# Non-secret SHA-1 certificate thumbprint (40 hexadecimal characters).
ANALYTIX_WINDOWS_EXPECTED_SIGNER_SHA1=<approved-signer-thumbprint>

### macOS signing and notarization
P12_PATH=/path/to/develop-id.p12
P12_PASSWORD=<p12-password>
P8_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
KEY_ID=<apple-key-id>
ISSUER=<apple-issuer-uuid>
